{
  "name": "@cob/rest-api-wrapper",
  "version": "2.9.2",
  "description": "Library of functions to simplify the interaction with a CoB server REST API",
  "keywords": [
    "cultofbits",
    "recordm",
    "rest-api"
  ],
  "main": "src/index.js",
  "browser": "dist/rest-api-wrapper.esm.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "browser": "./dist/rest-api-wrapper.esm.js",
      "default": "./src/index.js"
    },
    "./*": "./*"
  },
  "files": [
    "src",
    "dist",
    "types"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cob/rest-api-wrapper.git"
  },
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:integration": "node --experimental-vm-modules node_modules/.bin/jest --testPathIgnorePatterns=/node_modules/ --runInBand tests/integration",
    "lint": "eslint .",
    "build": "./node_modules/.bin/webpack --config webpack.config.js"
  },
  "author": "",
  "license": "SEE LICENSE IN <filename>",
  "dependencies": {
    "axios": "^1.20.0",
    "axios-cookiejar-support": "^4.0.7",
    "tough-cookie": "^4.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "webpack": "^5.28.0",
    "webpack-cli": "^4.6.0"
  },
  "type": "module",
  "jest": {
    "roots": [
      "src/",
      "tests/"
    ],
    "transform": {},
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/tests/integration/"
    ]
  }
}
